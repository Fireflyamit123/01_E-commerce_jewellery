/* --- Compact Hero Banner Slideshow --- */
.hero-section {
    width: 100%;
    height: 50vh;
    min-height: 350px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
}

.hero-section::before {
    content: "";
    position: absolute;
    inset: -15% -10%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.45), transparent 55%);
    animation: heroGlow 8s ease-in-out infinite alternate;
    z-index: 1;
}

@keyframes heroGlow {
    0% { transform: scale(0.98); opacity: 0.5; }
    100% { transform: scale(1.08); opacity: 1; }
}

.hero-section .slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 1.2s ease-in-out, transform 1.8s ease;
    will-change: opacity, transform;
}

.hero-section .slide.active {
    opacity: 1;
    transform: scale(1);
}

.hero-overlay {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    background: rgba(248, 244, 237, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.hero-content {
    position: relative;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(5px);
    padding: 25px 40px 30px;
    border-radius: 12px;
    border: 1px solid rgba(220, 210, 195, 0.6);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    overflow: hidden;
}

.hero-cartoons {
    position: absolute;
    inset: 10px 12px auto 12px;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
}

.cartoon-bubble {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.8);
    box-shadow: 0 6px 16px rgba(140, 109, 55, 0.12);
    font-size: 1.4rem;
    animation: floatEmoji 3.2s ease-in-out infinite;
}

.bubble-right {
    animation-delay: 0.7s;
}

@keyframes floatEmoji {
    0%, 100% {
        transform: translateY(0) scale(1);
    }
    50% {
        transform: translateY(-8px) scale(1.05);
    }
}

.hero-content .tagline {
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    font-style: italic;
    color: #8c6d37;
    margin-bottom: 6px;
}

.hero-content h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 600;
    background: linear-gradient(135deg, #3d352e 0%, #8c6d37 42%, #b38b46 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 15px;
    letter-spacing: 1px;
    text-shadow: 0 4px 18px rgba(140, 109, 55, 0.12);
}

.hero-badges {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 18px;
}

.hero-badges span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    background: #fff8ee;
    border: 1px solid #eadac4;
    color: #6e6255;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

.hero-btn {
    display: inline-block;
    padding: 10px 26px;
    background-color: #8c6d37;
    color: #ffffff;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    border-radius: 25px;
    transition: background 0.3s ease, transform 0.3s ease;
}

.hero-btn:hover {
    background-color: #735728;
    transform: translateY(-2px);
}

/* --- Main Marketplace Layout --- */
.main-container {
    max-width: 1300px;
    margin: 40px auto;
    padding: 0 20px;
}

.section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    text-align: center;
    background: linear-gradient(135deg, #3d352e 0%, #8c6d37 48%, #b38b46 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 30px;
    text-shadow: 0 0 18px rgba(198, 161, 101, 0.12);
    letter-spacing: 0.5px;
}

.shop-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
    padding: 14px 18px;
    border-top: 1px solid #eae2d6;
    border-bottom: 1px solid #eae2d6;
}

.shop-toolbar__label {
    color: #8c6d37;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
}

.category-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
}

.category-filter {
    padding: 8px 13px;
    border: 1px solid #dcd2c3;
    border-radius: 20px;
    background: #fff;
    color: #6e6255;
    cursor: pointer;
    font: inherit;
    font-size: 11px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
}

.category-filter:hover,
.category-filter.active {
    border-color: #8c6d37;
    background: linear-gradient(135deg, #8c6d37, #b38b46);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(140, 109, 55, 0.18);
}

.product-card[hidden] {
    display: none;
}

.product-detail-modal[hidden] {
    display: none;
}

.product-detail-modal {
    position: fixed;
    inset: 0;
    z-index: 2100;
    display: grid;
    place-items: center;
    padding: 20px;
}

.product-detail-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(61, 53, 46, 0.65);
    backdrop-filter: blur(4px);
}

.product-detail-modal__content {
    position: relative;
    width: min(100%, 900px);
    max-height: calc(100vh - 40px);
    overflow-y: auto;
    padding: 42px;
    border: 1px solid #eae2d6;
    border-radius: 10px;
    background: #fffdf9;
    box-shadow: 0 24px 70px rgba(61, 53, 46, 0.3);
}

.product-detail-modal__close {
    position: absolute;
    top: 14px;
    right: 18px;
    z-index: 1;
    border: 0;
    background: transparent;
    color: #6e6255;
    cursor: pointer;
    font-size: 28px;
    line-height: 1;
}

.product-detail-layout {
    display: grid;
    grid-template-columns: minmax(260px, 0.95fr) minmax(260px, 1.05fr);
    gap: 42px;
    align-items: center;
}

.product-detail-image-wrap {
    overflow: hidden;
    border-radius: 8px;
    background: #f6f0e8;
}

.product-detail-image-wrap img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
}

.product-detail-eyebrow {
    margin-bottom: 8px;
    color: #8c6d37;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
}

.product-detail-info h2 {
    margin-bottom: 12px;
    color: #3d352e;
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.6rem;
    line-height: 1.05;
}

.product-detail-rating {
    margin-bottom: 22px;
    color: #b38b46;
    font-size: 13px;
}

.product-detail-price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 18px;
}

.product-detail-price > span:first-child {
    color: #3d352e;
    font-size: 28px;
    font-weight: 600;
}

.product-detail-description {
    margin-bottom: 24px;
    color: #6e6255;
    font-size: 13px;
    line-height: 1.7;
}

.detail-quantity {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
    color: #52473c;
    font-size: 12px;
    font-weight: 600;
}

.detail-quantity input {
    width: 70px;
    padding: 9px;
    border: 1px solid #dcd2c3;
    border-radius: 5px;
    color: #3d352e;
    font: inherit;
}

.detail-actions {
    display: flex;
    gap: 10px;
}

.detail-buy-button,
.detail-cart-button {
    flex: 1;
    padding: 12px 16px;
    border-radius: 5px;
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
}

.detail-buy-button {
    border: 1px solid #8c6d37;
    background: #8c6d37;
    color: #fff;
}

.detail-cart-button {
    border: 1px solid #3d352e;
    background: transparent;
    color: #3d352e;
}

.detail-buy-button:hover,
.detail-cart-button:hover {
    background: #735728;
    border-color: #735728;
    color: #fff;
}

.detail-status {
    min-height: 18px;
    margin-top: 14px;
    font-size: 12px;
}

.detail-status.success {
    color: #2b7a4b;
}

/* --- Product Grid --- */
.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 25px;
}

.product-card {
    background: linear-gradient(180deg, #ffffff 0%, #fffdfb 100%);
    border: 1px solid #eadfcf;
    border-radius: 16px;
    padding: 15px 15px 14px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 8px 18px rgba(85, 70, 56, 0.04);
}

.product-card::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #d9b26c, #f7e7be, #d9b26c);
    opacity: 0.9;
}

.product-card::after {
    content: "";
    position: absolute;
    inset: -30% auto auto -20%;
    width: 60%;
    height: 150%;
    background: linear-gradient(120deg, transparent 35%, rgba(255, 255, 255, 0.7), transparent 70%);
    transform: translateX(-120%) rotate(12deg);
    transition: transform 0.8s ease;
}

.product-card:hover {
    transform: translateY(-6px) scale(1.01);
    box-shadow: 0 20px 36px rgba(140, 109, 55, 0.14);
    border-color: #d7bc88;
}

.product-card:hover::after {
    transform: translateX(240%) rotate(12deg);
}

.badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: linear-gradient(135deg, #8c6d37, #b38b46);
    color: #ffffff;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    padding: 5px 10px;
    border-radius: 999px;
    z-index: 2;
    box-shadow: 0 6px 12px rgba(140, 109, 55, 0.2);
}

.product-card img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 15px;
    border: 1px solid #f0e7dc;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.5);
}

.product-info {
    position: relative;
    z-index: 1;
}

.product-title {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.7px;
    text-transform: uppercase;
    color: #2f271f;
    margin-bottom: 8px;
    line-height: 1.45;
}

.rating {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #b38b46;
    font-size: 12px;
    margin-bottom: 10px;
    padding: 6px 8px;
    border-radius: 999px;
    background: #fff8ee;
    border: 1px solid #f0e2c7;
}

.rating span {
    color: #8c8275;
}

.price-box {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 8px;
}

.price {
    font-size: 20px;
    font-weight: 700;
    color: #3d352e;
}

.original-price {
    font-size: 13px;
    color: #a3988b;
    text-decoration: line-through;
}

.discount {
    font-size: 11px;
    color: #2b7a4b;
    font-weight: 700;
    background: #edf9f0;
    padding: 4px 7px;
    border-radius: 999px;
}

.delivery {
    font-size: 11px;
    color: #6e6255;
    margin-bottom: 15px;
    letter-spacing: 0.2px;
}

.add-to-cart-btn {
    width: 100%;
    background: linear-gradient(135deg, #3d352e, #5f5149);
    color: #ffffff;
    border: none;
    padding: 10px 0;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
    box-shadow: 0 10px 18px rgba(61, 53, 46, 0.14);
}

.add-to-cart-btn:hover {
    background: linear-gradient(135deg, #8c6d37, #b38b46);
    transform: translateY(-2px);
    box-shadow: 0 12px 22px rgba(140, 109, 55, 0.18);
}

.add-to-cart-btn.added {
    background: linear-gradient(135deg, #2b7a4b, #48a16e);
}

/* --- Marketplace Footer --- */
.site-footer {
    margin-top: 76px;
    background: #3d352e;
    color: #f8f4ed;
}

.footer-main {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr) 1.25fr;
    gap: 34px;
    max-width: 1300px;
    margin: 0 auto;
    padding: 56px 20px 48px;
}

.footer-logo {
    display: inline-block;
    margin-bottom: 14px;
    color: #ffffff;
    font-family: 'Cormorant Garamond', serif;
    font-size: 31px;
    font-weight: 700;
    letter-spacing: 2px;
}

.footer-logo span {
    color: #d6af68;
}

.footer-brand-column p,
.footer-contact-column p {
    max-width: 240px;
    color: #d8cec1;
    font-size: 12px;
    line-height: 1.8;
}

.footer-column,
.footer-contact-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.footer-column h3,
.footer-contact-column h3 {
    margin-bottom: 18px;
    color: #d6af68;
    font-size: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
}

.footer-column a,
.footer-socials a {
    margin-bottom: 11px;
    color: #f8f4ed;
    font-size: 12px;
    transition: color 0.2s ease;
}

.footer-column a:hover,
.footer-socials a:hover,
.footer-policies a:hover {
    color: #d6af68;
}

.footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 18px;
}

.footer-socials a {
    margin-bottom: 0;
    color: #d6af68;
    font-size: 11px;
}

.footer-hours {
    margin-top: 8px;
    color: #d6af68 !important;
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    max-width: 1300px;
    margin: 0 auto;
    padding: 18px 20px;
    border-top: 1px solid rgba(248, 244, 237, 0.18);
    color: #c7bbad;
    font-size: 11px;
}

.footer-policies {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}

.footer-policies a {
    color: #c7bbad;
    transition: color 0.2s ease;
}

/* --- Mobile Responsiveness --- */
@media (max-width: 768px) {
    .nav-container {
        flex-direction: column;
        gap: 12px;
    }

    .search-bar {
        width: 100%;
    }

    .hero-content h1 {
        font-size: 26px;
    }

    .hero-content {
        padding: 20px 15px;
    }

    .shop-toolbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .category-filters {
        justify-content: flex-start;
    }

    .about-highlights {
        grid-template-columns: 1fr;
    }

    .product-detail-modal__content {
        padding: 34px 22px 24px;
    }

    .product-detail-layout {
        grid-template-columns: 1fr;
        gap: 24px;
    }

    .product-detail-info h2 {
        font-size: 2.2rem;
    }

    .detail-actions {
        flex-direction: column;
    }

    .auth-modal__content {
        padding: 32px 22px 24px;
    }

    .registration-form {
        grid-template-columns: 1fr;
    }

    .footer-main {
        grid-template-columns: repeat(2, 1fr);
        gap: 38px 24px;
    }

    .footer-brand-column,
    .footer-contact-column {
        grid-column: 1 / -1;
    }

    .footer-bottom {
        align-items: flex-start;
        flex-direction: column;
    }

    .form-field--wide,
    .registration-submit,
    .registration-status {
        grid-column: auto;
    }
}
