.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 25px;
}

.product-card {
    background-color: #ffffff;
    border: 1px solid #eae2d6;
    border-radius: 10px;
    padding: 16px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(140, 109, 55, 0.12);
}

.badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: #8c6d37;
    color: #ffffff;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 10px;
    border-radius: 12px;
    z-index: 2;
}

.product-card img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 15px;
}

.product-title {
    font-size: 14px;
    font-weight: 500;
    color: #3d352e;
    margin-bottom: 8px;
    line-height: 1.4;
}

.rating {
    color: #b38b46;
    font-size: 12px;
    margin-bottom: 8px;
}

.rating span {
    color: #8c8275;
}

.price-box {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 6px;
}

.price {
    font-size: 18px;
    font-weight: 600;
    color: #3d352e;
}

.original-price {
    font-size: 13px;
    color: #a3988b;
    text-decoration: line-through;
}

.discount {
    font-size: 12px;
    color: #2b7a4b;
    font-weight: 600;
}

.delivery {
    font-size: 11px;
    color: #6e6255;
    margin-bottom: 15px;
}

.add-to-cart-btn {
    width: 100%;
    background-color: #3d352e;
    color: #ffffff;
    border: none;
    padding: 10px 0;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.3s ease;
}

.add-to-cart-btn:hover {
    background-color: #8c6d37;
}

/* --- Mobile Responsiveness --- */
@media (max-width: 768px) {
    .nav-container {
        flex-direction: column;
        gap: 12px;
    }

    .search-bar {
        width: 100%;
    }

    .hero-content h1 {
        font-size: 26px;
    }

    .hero-content {
        padding: 20px 15px;
    }

    .shop-toolbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .category-filters {
        justify-content: flex-start;
    }

    .about-highlights {
        grid-template-columns: 1fr;
    }

    .product-detail-modal__content {
        padding: 34px 22px 24px;
    }

    .product-detail-layout {
        grid-template-columns: 1fr;
        gap: 24px;
    }

    .product-detail-info h2 {
        font-size: 2.2rem;
    }

    .detail-actions {
        flex-direction: column;
    }

    .auth-modal__content {
        padding: 32px 22px 24px;
    }

    .registration-form {
        grid-template-columns: 1fr;
    }

    .form-field--wide,
    .registration-submit,
    .registration-status {
        grid-column: auto;
    }
}
