/* Shared Preview Card Base Styles */
.nav-preview-card {
    position: fixed;
    top: 70px;
    right: 20px;
    width: 280px;
    background-color: #ffffff;
    color: #333333;
    padding: 18px;
    border-radius: 10px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    border: 1px solid #eaeaea;
    z-index: 1000;
    
    /* Hover animation */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
    pointer-events: none;
}

.nav-preview-card.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

