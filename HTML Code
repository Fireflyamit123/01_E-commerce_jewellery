<!-- Registration dialog -->
<div class="auth-modal" id="registration-modal" role="dialog" aria-modal="true" aria-labelledby="registration-title" hidden>
    <div class="auth-modal__backdrop" data-close-registration></div>
    <section class="auth-modal__content">
        <button class="auth-modal__close" type="button" aria-label="Close registration form" data-close-registration>&times;</button>
        <p class="auth-modal__eyebrow">Welcome to TULIP</p>
        <h2 id="registration-title">Create your account</h2>
        <p class="auth-modal__intro">Save your details for a more personal jewellery experience.</p>
        <form id="registration-form" class="registration-form">
            <div class="form-field form-field--wide">
                <label for="full-name">Full name</label>
                <input id="full-name" name="fullName" type="text" autocomplete="name" required>
            </div>
            <div class="form-field">
                <label for="age">Age</label>
                <input id="age" name="age" type="number" min="13" max="120" inputmode="numeric" required>
            </div>
            <div class="form-field">
                <label for="phone">Phone number</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" pattern="[0-9+() .-]{7,}" required>
            </div>
            <div class="form-field form-field--wide">
                <label for="email">Email address</label>
                <input id="email" name="email" type="email" autocomplete="email" required>
            </div>
            <div class="form-field">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" minlength="8" autocomplete="new-password" required>
            </div>
            <div class="form-field">
                <label for="confirm-password">Confirm password</label>
                <input id="confirm-password" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required>
            </div>
            <button class="registration-submit" type="submit">Create account</button>
            <p class="registration-status" id="registration-status" role="status" aria-live="polite"></p>
        </form>
    </section>
</div>

