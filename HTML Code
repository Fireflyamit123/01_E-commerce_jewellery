<!-- Registration dialog -->
<div class="auth-modal" id="registration-modal" role="dialog" aria-modal="true" aria-labelledby="registration-title" hidden>
    <div class="auth-modal__backdrop" data-close-registration></div>
    <section class="auth-modal__content">
        <button class="auth-modal__close" type="button" aria-label="Close registration form" data-close-registration>&times;</button>
        <p class="auth-modal__eyebrow">Welcome to TULIP</p>
        <h2 id="registration-title">Create your account</h2>
        <p class="auth-modal__intro">Save your details for a more personal jewellery experience.</p>
        <form id="registration-form" class="registration-form">
            <div class="form-field form-field--wide">
                <label for="full-name">Full name</label>
                <input id="full-name" name="fullName" type="text" autocomplete="name" required>
            </div>
            <div class="form-field">
                <label for="age">Age</label>
                <input id="age" name="age" type="number" min="13" max="120" inputmode="numeric" required>
            </div>
            <div class="form-field">
                <label for="phone">Phone number</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" pattern="[0-9+() .-]{7,}" required>
            </div>
            <div class="form-field form-field--wide">
                <label for="email">Email address</label>
                <input id="email" name="email" type="email" autocomplete="email" required>
            </div>
            <div class="form-field">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" minlength="8" autocomplete="new-password" required>
            </div>
            <div class="form-field">
                <label for="confirm-password">Confirm password</label>
                <input id="confirm-password" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required>
            </div>
            <button class="registration-submit" type="submit">Create account</button>
            <p class="registration-status" id="registration-status" role="status" aria-live="polite"></p>
        </form>
    </section>
</div>

<!-- Product details view -->
<div class="product-detail-modal" id="product-detail-modal" role="dialog" aria-modal="true" aria-labelledby="detail-title" hidden>
    <div class="product-detail-modal__backdrop" data-close-product></div>
    <section class="product-detail-modal__content">
        <button class="product-detail-modal__close" type="button" aria-label="Close product details" data-close-product>&times;</button>
        <div class="product-detail-layout">
            <div class="product-detail-image-wrap">
                <img id="detail-image" src="" alt="">
            </div>
            <div class="product-detail-info">
                <p class="product-detail-eyebrow">TULIP fine jewellery</p>
                <h2 id="detail-title"></h2>
                <p id="detail-rating" class="product-detail-rating"></p>
                <div class="product-detail-price">
                    <span id="detail-price"></span>
                    <span id="detail-original-price" class="original-price"></span>
                </div>
                <p class="product-detail-description">A thoughtfully crafted piece designed to add a refined finish to every special moment.</p>
                <div class="detail-quantity">
                    <label for="detail-quantity-input">Quantity</label>
                    <input id="detail-quantity-input" type="number" min="1" max="10" value="1">
                </div>
                <div class="detail-actions">
                    <button id="detail-buy-now" class="detail-buy-button" type="button">Buy Now</button>
                    <button id="detail-add-cart" class="detail-cart-button" type="button">Add to Cart</button>
                </div>
                <p id="detail-status" class="detail-status" role="status" aria-live="polite"></p>
            </div>
        </div>
    </section>
</div>

